{
  "name": "Prettier",
  "description": "Opinionated code formatter",
  "category": "lint and formatting",
  "classificationStrategy": "semver",
  "sources": [
    {
      "role": "detection",
      "kind": "npm",
      "package": "prettier"
    },
    {
      "role": "notes",
      "kind": "github-releases",
      "repo": "prettier/prettier",
      "tagFormat": "{version}"
    }
  ]
}
