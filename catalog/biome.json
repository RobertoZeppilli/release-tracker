{
  "name": "Biome",
  "description": "Formatter and linter for web projects",
  "category": "lint and formatting",
  "classificationStrategy": "semver",
  "sources": [
    {
      "role": "detection",
      "kind": "npm",
      "package": "@biomejs/biome"
    },
    {
      "role": "notes",
      "kind": "github-releases",
      "repo": "biomejs/biome",
      "tagFormat": "@biomejs/biome@{version}"
    }
  ]
}
