          { "id": "module-factories", "about": "module pattern factories removed", "match": ["module pattern"] },
          { "id": "test-renderer-shallow", "about": "react-test-renderer/shallow removed", "match": ["shallow"] },
          { "id": "test-utils", "about": "react-dom/test-utils removed but act", "match": ["test-utils"] },
          { "id": "unmount", "about": "unmountComponentAtNode removed", "match": ["unmountcomponentatnode"] },
