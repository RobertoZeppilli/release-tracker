          { "id": "element-ref", "about": "element.ref deprecated for element.props.ref", "match": ["element.ref"] },
          { "id": "jsx-transform", "about": "the new JSX transform is required", "match": ["jsx transform"] },
          { "id": "matching-versions", "about": "react and react-dom versions must match", "match": ["react-dom", "match"] },
          { "id": "legacy-mode", "about": "legacy mode and renderToStaticNodeStream are removed", "match": ["legacy mode"] },
          { "id": "react-is", "about": "react-is drops isConcurrentMode and isAsyncMode", "match": ["react-is"] },
          { "id": "javascript-urls", "about": "javascript: URLs throw", "match": ["javascript:"] }
        ]
      }
