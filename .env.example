# Public URL of the app, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Locally, take the values from `pnpm exec supabase status`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY); in production, from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Set by `pnpm build:static` and by nobody else: it is which of the two builds this is, the app with
# its server or the public showcase, which is files alone (issue #215). Leave it unset here.
NEXT_PUBLIC_STATIC_SITE=

# Server-only: the job endpoints (/api/jobs/*) accept only `Authorization: Bearer <CRON_SECRET>`.
# At least 32 characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=

# Server-only: the Summary jobs call the Anthropic Message Batches API with this key.
# Without it /api/jobs/summaries/* answer 503. Never an Admin key (`sk-ant-admin...`).
ANTHROPIC_API_KEY=

# Server-only, optional: raises GitHub's rate limit from 60 requests an hour for the Detection.
GITHUB_TOKEN=

# Test-only: enables POST /api/test/revalidate and the page /test/throw, both of which the
# end-to-end tests need and nobody else does. At least 32 characters. Leave it unset in production:
# the route and the page answer 404.
E2E_AUTH_SECRET=

# Server-only, optional: the Slack app Verdict owns, behind "Add to Slack" in /settings (#188).
# Both unset is the normal state in development: Slack demands an HTTPS `redirect_uri`, so the round
# cannot run on localhost at all and the webhook field is the only way in. With both set, the button
# appears; the secret also signs the `state` of the round and never leaves the server.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
