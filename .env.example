# Public URL of the app, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Locally, take the values from `pnpm exec supabase status`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY); in production, from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only: the job endpoints (/api/jobs/*) accept only `Authorization: Bearer <CRON_SECRET>`.
# At least 32 characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=

# Server-only: the Summary jobs call the Anthropic Message Batches API with this key.
# Without it /api/jobs/summaries/* answer 503. Never an Admin key (`sk-ant-admin...`).
ANTHROPIC_API_KEY=

# Server-only, optional: raises GitHub's rate limit from 60 requests an hour for the Detection.
GITHUB_TOKEN=

# Test-only: enables POST /api/test/session, which signs a test Developer in without GitHub, for
# the end-to-end tests. At least 32 characters. Leave it unset in production: the route 404s.
E2E_AUTH_SECRET=
