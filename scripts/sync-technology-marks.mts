import { readdir, readFile, writeFile } from "node:fs/promises";
import * as simpleIcons from "simple-icons";
import { z } from "zod";

// Writes `src/modules/catalog/ui/technology-marks.ts` from the installed simple-icons, so the 24-unit
// paths live in the repository and the client never asks a CDN for one (CLAUDE.md). Run it by hand
// after a Technology joins the Catalog: `pnpm icons:sync`.
//
// It also writes `design/mocks/technology-marks.js`, keyed by the Catalog name instead of the slug,
// because the mocks build their rows from names. One source for both, so a mock cannot drift from
// the app's own shapes.

// Where a simple-icons slug differs from ours. Everything else matches by name.
const RENAMED: Record<string, string> = {
  "drizzle-orm": "drizzle",
  next: "nextdotjs",
  nodejs: "nodedotjs",
  "redux-toolkit": "redux",
  vue: "vuedotjs",
};

// Technologies left unmarked on purpose, each with the reason, so the next run does not look for them
// again. Their rows keep the reserved space empty (DESIGN.md, Technology Mark).
const UNMARKED: Record<string, string> = {
  playwright: "no icon in simple-icons",
  sveltekit: "only Svelte's own mark exists, and two rows of one list must not share one shape",
  zustand: "no icon in simple-icons",
};

// The package's own types are not trusted here: the shape is validated, so a renamed field fails
// loudly instead of writing a file full of `undefined`.
const IconSchema = z.object({ slug: z.string().min(1), path: z.string().min(1) });
const bySlug = new Map<string, z.infer<typeof IconSchema>>();
for (const candidate of Object.values(simpleIcons)) {
  const icon = IconSchema.safeParse(candidate);
  if (icon.success) bySlug.set(icon.data.slug, icon.data);
}

const CatalogFileSchema = z.object({ name: z.string().min(1) });
const slugs = (await readdir("catalog"))
  .filter((file) => file.endsWith(".json"))
  .map((file) => file.replace(/\.json$/, ""))
  .sort();
const names = new Map<string, string>();
for (const slug of slugs) {
  const file = CatalogFileSchema.parse(JSON.parse(await readFile(`catalog/${slug}.json`, "utf8")));
  names.set(slug, file.name);
}

const marks: string[] = [];
const mockMarks: string[] = [];
const missing: string[] = [];
for (const slug of slugs) {
  if (slug in UNMARKED) {
    console.log(`skip ${slug}: ${UNMARKED[slug]}`);
    continue;
  }
  const icon = bySlug.get(RENAMED[slug] ?? slug);
  if (!icon) {
    missing.push(slug);
    continue;
  }
  marks.push(`  "${slug}": "${icon.path}",`);
  mockMarks.push(`  "${names.get(slug)}": "${icon.path}",`);
}

if (missing.length > 0) {
  console.error(`No simple-icons entry for: ${missing.join(", ")}.`);
  console.error("Add it to RENAMED if the slug differs, or to UNMARKED with the reason.");
  process.exit(1);
}

// The package does not export its own manifest, so the version is read off disk: it belongs in the
// generated file, because a path only means something next to the release it came from.
const { version } = z
  .object({ version: z.string().min(1) })
  .parse(JSON.parse(await readFile("node_modules/simple-icons/package.json", "utf8")));
const file = `// Generated by \`pnpm icons:sync\`. Don't edit by hand.
//
// Paths from simple-icons ${version} (CC0-1.0), on a 24-unit grid. The brands belong to their owners;
// we use them nominatively, to say which Technology a line is about (docs/DECISIONI.md).
// ${slugs.length - marks.length} of ${slugs.length} Technologies are unmarked and keep their space empty.
export const TECHNOLOGY_MARKS: Record<string, string> = {
${marks.join("\n")}
};
`;

await writeFile("src/modules/catalog/ui/technology-marks.ts", file, "utf8");

const mockFile = `// Generated by \`pnpm icons:sync\`. Don't edit by hand. Keyed by Catalog name, for the mocks.
window.TECHNOLOGY_MARKS = {
${mockMarks.join("\n")}
};
`;
await writeFile("design/mocks/technology-marks.js", mockFile, "utf8");
console.log(`Wrote ${marks.length} mark(s) of ${slugs.length} Technologies.`);
