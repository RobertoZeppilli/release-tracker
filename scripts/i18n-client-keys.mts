import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { DEFAULT_LOCALE, dictionaryFor } from "@/modules/i18n";

// Which messages the browser is handed, decided by reading the client bundle instead of guessing.
// `LocaleProvider` used to carry the whole dictionary -- 505 messages, 44.830 bytes, the words of
// `privacy`, `terms` and `faq` included -- into every page, inlined in the HTML and again in the
// RSC payload. A Client Component cannot import the dictionaries itself (it would pull all five
// languages into the bundle), so the selection has to be made on the server, and the only honest
// source for it is what the bundler actually emitted: a key the browser can ask for is a key whose
// literal survives into a chunk.
//
// The list is generated and committed, so a pull request shows in its diff when the reach of the
// client grows, and `--check` is the CI guard that it was regenerated after the build.

const CHUNKS = join(process.cwd(), ".next", "static", "chunks");
const TARGET = join(process.cwd(), "src", "modules", "i18n", "server", "client-keys.ts");

function chunkFiles(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const full = join(directory, entry.name);
    if (entry.isDirectory()) return chunkFiles(full);
    return entry.name.endsWith(".js") ? [full] : [];
  });
}

// Quoted with whichever quote the minifier picked. A dotted key is never mangled, so a plain search
// for the literal is exact: it over-includes a key a shared chunk happens to carry, and misses none.
function isInBundle(key: string, bundle: string): boolean {
  return bundle.includes(`"${key}"`) || bundle.includes(`'${key}'`) || bundle.includes(`\`${key}\``);
}

function render(keys: readonly string[]): string {
  return [
    "// Generated by `pnpm i18n:client-keys`, which reads the built client chunks. Do not edit by",
    "// hand: `scripts/i18n-client-keys.mts` says why this list exists and how it is kept honest.",
    'import type { MessageKey } from "../domain/messages";',
    "",
    "// The messages the browser can ask for, and the only ones `clientDictionary` hands it.",
    "export const CLIENT_KEYS = [",
    ...keys.map((key) => `  "${key}",`),
    "] as const satisfies readonly MessageKey[];",
    "",
  ].join("\n");
}

let bundle: string;
try {
  bundle = chunkFiles(CHUNKS)
    .map((file) => readFileSync(file, "utf8"))
    .join("\n");
} catch {
  throw new Error(`No client chunks under ${CHUNKS}. Run \`pnpm build\` first.`);
}

const english = dictionaryFor(DEFAULT_LOCALE);
const keys = Object.keys(english)
  .filter((key) => isInBundle(key, bundle))
  .sort();

// The one way this measure could lie to itself: if the generated list ever reached a client chunk,
// every key in it would read as "used by the browser" and the list would hold its own shape for
// ever. The boundary rule and the `server-only` index make that unreachable, and this says so out
// loud if it happens anyway -- the array literal would put the first two keys side by side.
if (keys.length > 1 && bundle.includes(`"${keys[0]}","${keys[1]}"`)) {
  throw new Error("CLIENT_KEYS is in a client chunk: the list is being measured against itself.");
}

const written = render(keys);

if (process.argv.includes("--check")) {
  const current = readFileSync(TARGET, "utf8");
  if (current !== written) {
    throw new Error(
      `${TARGET} is stale: ${keys.length} of ${Object.keys(english).length} messages reach the client in this build. Run \`pnpm build && pnpm i18n:client-keys\` and commit the result.`,
    );
  }
  console.log(`client-keys.ts is current: ${keys.length} of ${Object.keys(english).length} messages reach the client.`);
} else {
  writeFileSync(TARGET, written, "utf8");
  console.log(`Written ${keys.length} of ${Object.keys(english).length} messages to ${TARGET}.`);
}
